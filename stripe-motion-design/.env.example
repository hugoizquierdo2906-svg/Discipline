# stripe-motion-design — environment variables
# Copy this file to `.env` and fill in your own values.
# NEVER commit `.env`. The secret key must stay server-side only.

# --- Stripe API keys (Dashboard → Developers → API keys) ---
# Start in TEST mode. Test keys begin with sk_test_ / pk_test_.
# Switch to live keys (sk_live_ / pk_live_) only when you go live.
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# --- Webhook signing secret ---
# Local dev: run `stripe listen --forward-to localhost:4242/api/stripe/webhook`
#   and paste the `whsec_...` it prints here.
# Production: Dashboard → Developers → Webhooks → your endpoint → Signing secret.
STRIPE_WEBHOOK_SECRET=whsec_xxx

# --- Business defaults ---
# ISO 4217 currency code. EUR for a France-based business.
CURRENCY=eur
# Locale for hosted invoice pages / Checkout (fr, en, ...).
LOCALE=fr
# Net payment terms for invoices, in days (e.g. 30 = "net 30").
INVOICE_DAYS_UNTIL_DUE=30
# Shown at the bottom of every invoice. For a French micro-entreprise not
# charging VAT, this is typically: "TVA non applicable, art. 293 B du CGI".
INVOICE_FOOTER=TVA non applicable, art. 293 B du CGI

# --- URLs used by Checkout redirects (your motion-design site) ---
APP_URL=http://localhost:4242
CHECKOUT_SUCCESS_URL=http://localhost:4242/paiement/merci
CHECKOUT_CANCEL_URL=http://localhost:4242/paiement/annule

# --- Local server ---
PORT=4242
