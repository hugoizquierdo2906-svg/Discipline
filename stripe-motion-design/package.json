{
  "name": "stripe-motion-design",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone Stripe integration (Payments + Invoicing) for a motion-design freelance business. Independent of the DISCIPLINE app it lives beside — copy this folder into your own project.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "type-check": "tsc --noEmit",
    "invoice": "tsx scripts/send-invoice.ts",
    "payment-link": "tsx scripts/create-payment-link.ts",
    "account": "tsx scripts/check-account.ts"
  },
  "dependencies": {
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "https-proxy-agent": "^9.1.0",
    "stripe": "22.3.2"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.1.1",
    "tsx": "4.23.1",
    "typescript": "7.0.2"
  }
}
