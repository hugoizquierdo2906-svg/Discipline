# DISCIPLINE — environment variables template
# Copy to `.env.local` for development. NEVER commit real secrets.
# Each variable is introduced in the phase noted in brackets.

# --- Database [Phase 18] ---
DATABASE_URL=

# --- Authentication [Phase 19] ---
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# OAuth — Google [Phase 19]
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth — Apple [Phase 19]
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# OAuth — Microsoft [Phase 19]
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# --- Payments — Stripe [Phase 30/31] ---
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Email — Resend [Phase 34] ---
RESEND_API_KEY=
EMAIL_FROM=

# --- Storage — Cloudflare R2 [Phase 35] ---
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=
CLOUDFLARE_R2_PUBLIC_URL=

# --- Monitoring [Phase 42] ---
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# --- App [Phase 43] ---
NEXT_PUBLIC_APP_URL=
