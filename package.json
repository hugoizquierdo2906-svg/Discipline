{
  "name": "discipline",
  "version": "0.1.0",
  "private": true,
  "description": "DISCIPLINE — premium fitness coaching platform.",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "22.22.2",
    "pnpm": "10.33.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "dependencies": {
    "geist": "1.7.2",
    "next": "15.5.19",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "22.18.10",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.0",
    "@eslint/eslintrc": "3.3.5",
    "eslint-config-next": "15.5.19",
    "eslint-import-resolver-typescript": "4.4.5",
    "@typescript-eslint/parser": "8.46.4",
    "@typescript-eslint/eslint-plugin": "8.46.4",
    "autoprefixer": "10.5.2",
    "postcss": "8.5.16",
    "tailwindcss": "3.4.19",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-import": "2.32.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.4",
    "husky": "9.1.7",
    "lint-staged": "16.2.7"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,jsx,mjs,cjs,json,css,md}": [
      "prettier --write"
    ]
  }
}
